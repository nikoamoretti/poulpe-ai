POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
LOG_REQUESTS=true

DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@postgres:5432/orchestrator
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://backend:8000
SEED_DEMO_DATA=true
SEED_DEMO_DATA_IF_EMPTY=true

ORCHESTRATOR_REPOS_ROOT=/workspace/.orchestrator/repos
ORCHESTRATOR_WORKSPACES_ROOT=/workspace/.orchestrator/workspaces
